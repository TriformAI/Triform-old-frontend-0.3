{
	"name": "triform-app",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"format:watch": "onchange \"src/**/*.{js,ts,svelte}\" -- prettier --write {{changed}}",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"parse:schema": "./parse_schema.sh"
	},
	"devDependencies": {
		"@eslint/js": "^9.21.0",
		"@iconify-json/bxl": "^1.2.2",
		"@iconify-json/material-symbols": "^1.2.14",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.50.1",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.17.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/postcss": "^4.0.8",
		"@types/eslint": "^9.6.1",
		"@types/node": "^22.13.5",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.21.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"json-schema-to-typescript": "^15.0.4",
		"json-tool": "^1.1.2",
		"json2ts": "^0.0.7",
		"postcss": "^8.5.3",
		"prettier": "^3.5.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.20.2",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.1.4",
		"svelte-sonner": "^0.3.28",
		"sveltekit-sse": "^0.13.14",
		"tailwindcss": "^4.0.8",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.24.1",
		"unplugin-icons": "^0.22.0",
		"vite": "^6.1.1",
		"vitest": "^2.1.9",
		"web-worker": "^1.5.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/figtree": "^5.1.2",
		"@fontsource/space-mono": "^5.1.2",
		"@iconify/svelte": "^4.2.0",
		"@monaco-editor/loader": "^1.5.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@tolgee/svelte": "^6.1.1",
		"@xyflow/svelte": "^0.1.30",
		"balloon-css": "^1.2.0",
		"bits-ui": "^1.3.2",
		"chart.js": "^4.4.8",
		"date-fns": "^4.1.0",
		"elkjs": "^0.9.3",
		"fetch-event-stream": "^0.1.5",
		"monaco-themes": "^0.4.4",
		"prism-code-editor": "^3.4.0",
		"svelte-headlessui": "^0.0.45",
		"svelte-transition": "^0.0.17"
	}
}
