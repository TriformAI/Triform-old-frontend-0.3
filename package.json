{
	"name": "triform-app",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write . && eslint --fix .",
		"format:watch": "onchange \"src/**/*.{js,ts,svelte}\" -- prettier --write {{changed}}",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"parse:schema": "./parse_schema.sh",
		"update-deps": "bunx npm-check-updates --root --format group -i"
	},
	"devDependencies": {
		"@eslint/js": "^9.28.0",
		"@iconify-json/bxl": "^1.2.2",
		"@iconify-json/material-symbols": "^1.2.24",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.52.0",
		"@sveltejs/adapter-auto": "^6.0.1",
		"@sveltejs/kit": "^2.21.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/postcss": "^4.1.8",
		"@types/eslint": "^9.6.1",
		"@types/node": "^22.15.29",
		"@types/ws": "^8.18.1",
		"autoprefixer": "^10.4.21",
		"drizzle-kit": "^0.31.1",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"json-schema-to-typescript": "^15.0.4",
		"json-tool": "^1.1.2",
		"json2ts": "^0.0.7",
		"monaco-editor": "^0.52.2",
		"postcss": "^8.5.4",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.33.14",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.2.1",
		"svelte-sonner": "^0.3.28",
		"sveltekit-sse": "^0.13.14",
		"tailwindcss": "^4.1.8",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.1",
		"unplugin-icons": "^0.22.0",
		"vite": "^6.3.5",
		"vitest": "^2.1.9",
		"web-worker": "^1.5.0"
	},
	"type": "module",
	"dependencies": {
		"@dagrejs/dagre": "^1.1.4",
		"@fontsource-variable/figtree": "^5.2.8",
		"@fontsource/space-mono": "^5.2.5",
		"@iconify/svelte": "^4.2.0",
		"@monaco-editor/loader": "^1.5.0",
		"@neondatabase/serverless": "^1.0.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@tolgee/svelte": "^6.2.5",
		"@xyflow/svelte": "^1.0.2",
		"balloon-css": "^1.2.0",
		"bits-ui": "^2.4.1",
		"bufferutil": "^4.0.9",
		"chart.js": "^4.4.9",
		"cron-validate": "^1.5.2",
		"cronstrue": "^2.61.0",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.43.1",
		"fetch-event-stream": "^0.1.5",
		"just-compare": "^2.3.0",
		"just-pick": "^4.2.0",
		"monaco-themes": "^0.4.4",
		"motion": "^12.16.0",
		"prism-code-editor": "^3.4.0",
		"svelte-headlessui": "^0.0.45",
		"svelte-infinite": "^0.5.0",
		"svelte-transition": "^0.0.17",
		"tailwind-merge": "^3.3.0",
		"ws": "^8.18.2"
	}
}
